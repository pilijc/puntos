{
  "expo": {
    "scheme": "puntos",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./src/assets/images/puntos-icon.png",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/images/puntos-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "{process.env.EXPO_PUBLIC_MAPBOX_DOWNLOADS_TOKEN}"
        }
      ]
    ],
    "name": "puntos",
    "slug": "puntos",
    "android": {
      "package": "com.mobile.puntos"
    },
    "ios": {
      "bundleIdentifier": "com.mobile.puntos"
    }
  }
}
