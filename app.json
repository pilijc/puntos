{
  "expo": {
    "scheme": "puntos",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./src/assets/images/puntos-icon.png",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/images/puntos-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Puntos needs your location to show nearby stores and enable check-ins.",
          "locationAlwaysPermission": "Puntos needs your location to show nearby stores and enable check-ins.",
          "locationWhenInUsePermission": "Puntos needs your location to show nearby stores and enable check-ins."
        }
      ]
    ],
    "name": "puntos",
    "slug": "puntos",
    "android": {
      "package": "com.anonymous.puntos"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.puntos"
    }
  }
}
